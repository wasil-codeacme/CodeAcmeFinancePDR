# Postgres used by the app at runtime. Locally `pnpm db:local` (Prisma dev server) prints one.
DATABASE_URL=
# Optional direct (unpooled) connection for migrations when DATABASE_URL goes through a pooler.
# Vercel runs `prisma migrate deploy` on every deploy (the `vercel-build` script).
DIRECT_DATABASE_URL=
# Shadow database for `prisma migrate dev` (the Prisma dev server exposes one on the next port).
SHADOW_DATABASE_URL=

# Public base URL, used in invite emails, e.g. https://finance.codeacme.com
APP_URL=

# "resend" sends real email; "console" prints sign-in codes to the server log (local only,
# refused in production).
EMAIL_PROVIDER=console
EMAIL_FROM="CodeAcme Finance <noreply@codeacme.com>"
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Optional pino log level (fatal|error|warn|info|debug|trace).
LOG_LEVEL=info

# Max pooled DB connections (1 for the embedded Prisma dev database).
DATABASE_POOL_MAX=5
